.tabs{display:flex;gap:6px;margin-bottom:12px}.tabs button{flex:1;padding:10px;border:1px solid var(--bd);background:var(--cd);color:var(--tx);border-radius:10px;font:inherit;font-weight:600}
.tabs .on{background:var(--pr);color:#fff;border-color:var(--pr)}
.card{background:var(--cd);border:1px solid var(--bd);border-radius:16px;padding:16px;margin-bottom:12px}
h1{font-size:22px;margin:4px 0 8px}h2{font-size:21px;margin:0 0 12px}
.big{display:block;width:100%;padding:18px;margin:10px 0;border-radius:14px;border:2px solid var(--bd);background:var(--cd);color:var(--tx);font:inherit;font-size:20px;font-weight:600;text-align:left}
.big.sel{border-color:var(--pr);background:var(--pr);color:#fff}.big.r{border-left:8px solid var(--rd)}.big.a{border-left:8px solid var(--am)}
