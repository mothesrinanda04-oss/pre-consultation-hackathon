# Auto detect text files and perform LF normalization
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>OP Queue AI Assistant</title>
<style>
:root{box-sizing:border-box;--bg:#f3f8fb;--cd:#fff;--tx:#12263a;--mu:#5b6b7a;--pr:#0a7ea4;--ok:#1b8a4b;--am:#b86e00;--rd:#c62828;--bd:#d3dee7}
